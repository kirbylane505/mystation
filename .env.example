# MyStation Environment Variables
# Copy this to .env.local and fill in your values
# Generated 2026-08-15 from src/ grep — keep in sync when adding new env references
#
# NEVER commit .env.local — it is in .gitignore for a reason.

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================
# SUPABASE — Database & Auth
# https://supabase.com/dashboard
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SERVER ONLY — never expose to client

# ============================================================
# STRIPE — Payments
# https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM=price_xxx
STRIPE_PRICE_CREATOR=price_xxx

# ============================================================
# CLOUDFLARE R2 — Audio Storage (152 tracks)
# https://dash.cloudflare.com → R2
# ============================================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mystation-audio
R2_PUBLIC_URL=https://audio.mystationlive.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://audio.mystationlive.com

# ============================================================
# RESEND — Transactional email (Kit + admin alerts)
# https://resend.com/api-keys
# Admin alerts route to mystationlive@gmail.com (canonical)
# ============================================================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@mystationlive.com

# ============================================================
# KIT (formerly ConvertKit) — Newsletter + lifecycle
# ============================================================
KIT_API_SECRET=your-kit-api-secret

# ============================================================
# PRINTIFY — Merch fulfillment
# ============================================================
PRINTIFY_API_KEY=your-printify-key
PRINTIFY_SHOP_ID=your-shop-id
PRINTIFY_WEBHOOK_SECRET=your-webhook-secret

# ============================================================
# PRINTFUL — Merch fulfillment (secondary integration)
# ============================================================
PRINTFUL_API_KEY=your-printful-key
PRINTFUL_WEBHOOK_SECRET=your-webhook-secret

# ============================================================
# SPOTIFY — Search paywall (Diamond tier)
# https://developer.spotify.com/dashboard
# ============================================================
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ============================================================
# MUX — Video hosting
# ============================================================
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# ============================================================
# LIVEKIT — Live streaming (podstation)
# ============================================================
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url

# ============================================================
# WEB PUSH — Notifications
# Generate via: npx web-push generate-vapid-keys
# ============================================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXXX
VAPID_PRIVATE_KEY=your-vapid-private-key

# ============================================================
# SECURITY — Signed cookies, admin auth, cron auth
# Use `openssl rand -hex 32` to generate
# ============================================================
ADMIN_KEY=long-random-string                       # required — no fallback in prod
AUDIO_SECRET=long-random-hex                       # HMAC for audio-token cookies
CRON_SECRET=long-random-string                     # Vercel cron Authorization Bearer
FAN_WALL_OWNER_SECRET=long-random-string
FRIEND_ACCESS_CODE=short-code-for-friends
IP_HASH_SALT=long-random-string
MYSTATION_SHARED_SECRET=long-random-string
SITE_PASSWORD=coming-soon-gate-password
VAULT_PIN=your-vault-pin
VAULT_SECRET=long-random-string

# ============================================================
# SENTRY — Error monitoring
# https://sentry.io
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN — set on Vercel only for source-map upload

# ============================================================
# POSTHOG — Product analytics
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================
# ANALYTICS — Meta Pixel + GA (optional)
# ============================================================
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================================
# CASHAPP — Manual receiving (no API)
# ============================================================
NEXT_PUBLIC_CASHAPP_TAG=$RIDE4PAGEMUSIC847

# ============================================================
# FEATURE FLAGS
# ============================================================
MYSTATION_MONETIZATION_MODE=paywall               # paywall | free | mixed
