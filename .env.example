# MyStation Environment Variables
# Copy this to .env.local and fill in your values

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# SUPABASE - Database & Auth (FREE TIER)
# Get these from: https://supabase.com/dashboard
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# CLOUDFLARE R2 - Audio Storage ($0.015/GB)
# Get these from: https://dash.cloudflare.com → R2
# ===========================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mystation-audio
NEXT_PUBLIC_R2_PUBLIC_URL=https://audio.mystation.app

# ===========================================
# CASHAPP - Payments (No API needed)
# ===========================================
NEXT_PUBLIC_CASHAPP_TAG=$RIDE4PAGEMUSIC847

# ===========================================
# OPTIONAL - Analytics
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===========================================
# OPTIONAL - Live Streaming (Agora)
# ===========================================
# AGORA_APP_ID=your_agora_app_id
# AGORA_APP_CERTIFICATE=your_agora_certificate
